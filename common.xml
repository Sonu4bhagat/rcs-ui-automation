<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Common suite: all classes in src/test/java/tests/common (generated from testng.xml - keep in sync).
    Each class is its own <test>, so classes run one after another (same as testng.xml).
    Classes share one login per role, so running them in parallel makes them log each other out.
-->
<suite name="Common Automation Suite" verbose="1" parallel="classes" thread-count="4">
    <listeners>
        <listener class-name="utils.AnnotationTransformer"/>
    </listeners>

    <test name="Login Tests" preserve-order="true">
        <classes>
            <class name="tests.common.LoginTest"/>
        </classes>
    </test>
</suite>
