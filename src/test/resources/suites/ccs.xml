<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    CCS suite: all classes in src/test/java/tests/ccs (CCS project, own Enterprise account - enums.CCSUser).
    Each class is its own <test>, so classes run one after another.
    Run: mvn test -DsuiteXmlFile=src/test/resources/suites/ccs.xml
-->
<suite name="CCS Automation Suite" verbose="1" parallel="classes" thread-count="4">
    <listeners>
        <listener class-name="utils.AnnotationTransformer"/>
    </listeners>

    <!-- Part A: Enterprise login and CCS SSO into CCS-Live -->
    <test name="CCS Enterprise SSO" preserve-order="true">
        <classes>
            <class name="tests.ccs.CCSEnterpriseSSOTest"/>
        </classes>
    </test>

    <!-- Part B: Enterprise Users management in CCS-Live (starts on the CCS-Live dashboard) -->
    <test name="CCS Enterprise Users" preserve-order="true">
        <classes>
            <class name="tests.ccs.CCSEnterpriseUsers"/>
        </classes>
    </test>

    <!-- Part C: Call Flow - Queue with the Part B agent and Call Waiting Type "Queue" (starts on the CCS-Live dashboard) -->
    <test name="CCS Enterprise Call Flow" preserve-order="true">
        <classes>
            <class name="tests.ccs.CCSEnterpriseCallFlow"/>
        </classes>
    </test>

    <!-- Part D: Campaign - Click to Call - Manual campaign, scheduled from its Calendar, verified Running (starts on the CCS-Live dashboard) -->
    <test name="CCS Enterprise Campaign" preserve-order="true">
        <classes>
            <class name="tests.ccs.CCSEnterpriseCampaign"/>
        </classes>
    </test>

    <!-- Part E: Agent tab - Part B agent logs in with WebRTC and the Part D campaign -->
    <test name="CCS Enterprise Agent Tab" preserve-order="true">
        <classes>
            <class name="tests.ccs.CCSEnterpriseAgentTab"/>
        </classes>
    </test>

    <!-- Cleanup: deletes this execution's campaign, queue and agent - runs only when CCS Enterprise Agent Tab passed -->
    <test name="CCS Cleanup" preserve-order="true">
        <classes>
            <class name="tests.ccs.CCSCleanup"/>
        </classes>
    </test>
</suite>
