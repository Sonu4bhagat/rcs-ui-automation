<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="RCS Automation Test Suite" verbose="1" parallel="classes" thread-count="4">
    <listeners>
        <listener class-name="utils.AnnotationTransformer"/>
    </listeners>
    <!-- ExtentReports handled by BaseTest to avoid duplicate entries -->
    
    <!-- ===== COMMON (all roles) : tests/common ===== -->
    <test name="Login Tests" preserve-order="true">
        <classes>
            <class name="tests.common.LoginTest"/>
        </classes>
    </test>
    
    <!-- ===== ENTERPRISE : tests/enterprise ===== -->
    <test name="Enterprise Dashboard Navigation" preserve-order="true">
        <classes>
            <class name="tests.enterprise.EnterpriseDashboardNavigationTest"/>
        </classes>
    </test>
    
    <test name="Enterprise Services Tab" preserve-order="true">
        <classes>
            <class name="tests.enterprise.EnterpriseServicesTabTest"/>
        </classes>
    </test>
    
    <test name="Enterprise API Documentation" preserve-order="true">
        <classes>
            <class name="tests.enterprise.EnterpriseAPIDocumentationTest"/>
        </classes>
    </test>
    
    <test name="Enterprise Wallet Tab" preserve-order="true">
        <classes>
            <class name="tests.enterprise.EnterpriseWalletTabTest"/>
        </classes>
    </test>
    
    <test name="Enterprise Roles Management" preserve-order="true">
        <classes>
            <class name="tests.enterprise.EnterpriseRolesManagementTest"/>
        </classes>
    </test>
    
    <test name="Enterprise Reports Tab" preserve-order="true">
        <classes>
            <class name="tests.enterprise.EnterpriseReportsTabTest"/>
        </classes>
    </test>
    
    <test name="Enterprise Rate Card Tab" preserve-order="true">
        <classes>
            <class name="tests.enterprise.EnterpriseRateCardTabTest"/>
        </classes>
    </test>
    
    <test name="Enterprise Control Center" preserve-order="true">
        <classes>
            <class name="tests.enterprise.EnterpriseControlCenterTabTest"/>
        </classes>
    </test>
    
    <test name="Enterprise RCS Assistant Flow" preserve-order="true">
        <classes>
            <class name="tests.enterprise.EnterpriseRCSAssistantFlowTest"/>
        </classes>
    </test>

    <!-- Excluded from Jenkins runs - uncomment to run them again
    <test name="Enterprise Assistant List CA" preserve-order="true">
        <classes>
            <class name="tests.enterprise.AssistantListTestCA"/>
        </classes>
    </test>

    <test name="Media Library" preserve-order="true">
        <classes>
            <class name="tests.enterprise.MediaLibraryTest"/>
        </classes>
    </test>
    -->
    
    <!-- ===== SUPER ADMIN : tests/superadmin ===== -->
    <test name="Super Admin Customer Org" preserve-order="true">
