<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Super Admin suite: all classes in src/test/java/tests/superadmin (generated from testng.xml - keep in sync).
    Each class is its own <test>, so classes run one after another (same as testng.xml).
    Classes share one login per role, so running them in parallel makes them log each other out.
-->
<suite name="Super Admin Automation Suite" verbose="1" parallel="classes" thread-count="4">
    <listeners>
        <listener class-name="utils.AnnotationTransformer"/>
    </listeners>

    <test name="Super Admin Customer Org" preserve-order="true">
        <classes>
            <class name="tests.superadmin.SuperAdminCustomerOrgTest"/>
        </classes>
    </test>

    <test name="Super Admin Dashboard" preserve-order="true">
        <classes>
            <class name="tests.superadmin.SuperAdminDashboardTest"/>
        </classes>
    </test>

    <test name="Super Admin Roles Management" preserve-order="true">
        <classes>
            <class name="tests.superadmin.SuperAdminRolesManagementTest"/>
        </classes>
    </test>

    <test name="Super Admin Team Management" preserve-order="true">
        <classes>
            <class name="tests.superadmin.SuperAdminTeamManagementTest"/>
        </classes>
    </test>

    <test name="Super Admin API Documentation" preserve-order="true">
        <classes>
            <class name="tests.superadmin.SuperAdminAPIAndDocumentationTest"/>
        </classes>
    </test>

    <test name="Super Admin Service Node SSO" preserve-order="true">
        <classes>
            <class name="tests.superadmin.SuperAdminServiceNodeSSOTest"/>
        </classes>
    </test>
</suite>
